#
# Copy this file to smartcontract/.env (preferred) or smartcontract/test/.env
# and fill in the secrets below to run the Node.js test runner directly
# against the Polygon Amoy network.
#
# RPC endpoint for Polygon Amoy (Alchemy, Infura, or public RPC).
# Example public endpoint is shown below; replace with your own reliable RPC
# if needed.
RPC_URL=https://rpc-amoy.polygon.technology

# Chain metadata so ethers.js can validate the connection.
CHAIN_ID=80002
CHAIN_NAME=polygon-amoy

# Signer that owns the admin role on your deployed Direction1155C contract.
# This account must hold Amoy MATIC because the tests deploy fresh contracts
# and fund several helper wallets.
TEST_SIGNER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TEST_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: automatically top up role wallets with MATIC (in ether units). Set to 0 to disable.
TEST_ROLE_MATIC_FUND=0

# Optional: custom artifact paths (relative to smartcontract/test/ unless absolute)
# SMARTCONTRACT_PATH=../artifacts/contracts/Direction1155C.sol/Direction1155C.json
# PAYMENT_TOKEN_ARTIFACT_PATH=../artifacts/contracts/mocks/MockERC20.sol/MockERC20.json

# Optional: reuse existing on-chain deployments (recommended for Amoy)
# If both values are blank the test deploys fresh contracts each time.
TEST_EXISTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TEST_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Faucet toggle: when false, the script will NOT mint/airdrop mock USDT.
# Set to false only if TEST_PAYMENT_TOKEN_ADDRESS already points to a funded token.
ALLOW_FAUCET=true

# Optional: provide dedicated wallets for each role. If omitted, the test will
# generate random wallets for that role.
TEST_NOTARY_PRIVATE_KEY=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
TEST_NOTARY_ADDRESS=0x1111111111111111111111111111111111111111

TEST_MANAGER_PRIVATE_KEY=0xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
TEST_MANAGER_ADDRESS=0x2222222222222222222222222222222222222222

TEST_OWNER_PRIVATE_KEY=0xdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
TEST_OWNER_ADDRESS=0x3333333333333333333333333333333333333333

TEST_INVESTOR_PRIVATE_KEY=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
TEST_INVESTOR_ADDRESS=0x4444444444444444444444444444444444444444

# Marketplace testing knobs
TEST_PAYMENT_TOKEN_DECIMALS=18
TEST_MOCK_USDT_AIRDROP=1000
TEST_LISTING_PRICE=0.01
TEST_INTEREST_AMOUNT=0.001
TEST_FEE_BUMP_PERCENT=20
TEST_FEE_RETRIES=3
FORCE_MINT=false
